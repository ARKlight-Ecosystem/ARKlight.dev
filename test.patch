diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
deleted file mode 100644
index fcac44f..0000000
--- a/.github/workflows/deploy.yml
+++ /dev/null
@@ -1,56 +0,0 @@
-# UNTESTED scaffold: deploys to GitHub Pages. Review before relying on it.
-#
-# Repo settings needed:
-#   Settings > Pages > Source: "GitHub Actions"
-#   Variables: SITE_URL (e.g. https://arklight.example), SITE_PHASE (1 or 2, default 1),
-#              CNAME_HOST (optional, your custom domain)
-#
-# ARKLIGHT_ACCEPT_LICENSE=1 below means YOU have read ARKlight's LICENSE
-# and accept it for this build. Do not leave it in if you have not.
-name: deploy
-on:
-  push:
-    branches: [main]
-  workflow_dispatch:
-
-permissions:
-  contents: read
-  pages: write
-  id-token: write
-
-concurrency:
-  group: pages
-  cancel-in-progress: true
-
-jobs:
-  build:
-    runs-on: ubuntu-latest
-    env:
-      ARKLIGHT_ACCEPT_LICENSE: "1"
-      SITE_URL: ${{ vars.SITE_URL }}
-      CNAME_HOST: ${{ vars.CNAME_HOST }}
-      PHASE: ${{ vars.SITE_PHASE || '1' }}
-    steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-python@v5
-        with:
-          python-version: "3.12"
-      - run: pip install arklight
-      - run: python scripts/check_content.py --release --phase "$PHASE"
-      - run: python scripts/gen_site.py "$PHASE"
-      - run: arklight build site.py -o ARK --no-open
-      - run: python scripts/postbuild.py ARK
-      - uses: actions/configure-pages@v5
-      - uses: actions/upload-pages-artifact@v3
-        with:
-          path: ARK
-
-  deploy:
-    needs: build
-    runs-on: ubuntu-latest
-    environment:
-      name: github-pages
-      url: ${{ steps.deployment.outputs.page_url }}
-    steps:
-      - id: deployment
-        uses: actions/deploy-pages@v4
